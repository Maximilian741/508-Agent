# ============================================================================
# 508 Agent - LOCAL DEVELOPMENT environment configuration
# ============================================================================
# Copy this file to `.env` (NOT committed) for local dev (sqlite, APP_ENV below).
# The AI keys near the bottom are optional - the app falls back to heuristics.
#
# >>> DEPLOYING TO PRODUCTION? Do NOT copy this file. Use `deploy/.env.example`
#     (next to docker-compose.yml) instead — it has the Postgres, frontend-build,
#     Cloudflare-tunnel, and Stripe keys that `docker compose up` requires, and
#     defaults APP_ENV=production (which enables the prod safety rails:
#     alembic-only migrations, strict CORS, and a required APP_SECRET).
# ============================================================================

APP_ENV=development
APP_VERSION=0.1.0

# Required in production. Leave blank in dev and a per-process random secret
# is generated on backend startup.
APP_SECRET=

# ----------------------------------------------------------------------------
# Database
# ----------------------------------------------------------------------------
# sqlite dev default
DATABASE_URL=sqlite:///./.runtime/508_agent.db
# production target
# DATABASE_URL=postgresql+psycopg://agent:password@localhost:5432/agentdb

# ----------------------------------------------------------------------------
# Storage (uploaded + remediated documents)
# ----------------------------------------------------------------------------
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=backend/.runtime/storage
MATERIALIZED_ROOT=backend/.runtime/materialized

# for STORAGE_PROVIDER=s3 (or any S3-compatible service like Cloudflare R2)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_PREFIX=508-agent
S3_ENDPOINT_URL=
S3_FORCE_PATH_STYLE=true
PRESIGN_EXPIRES_SECONDS=3600
ENABLE_DEV_STORAGE_ENDPOINT=false

# ----------------------------------------------------------------------------
# CORS / upload limits
# ----------------------------------------------------------------------------
CORS_ALLOW_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:3000,http://127.0.0.1:3000
MAX_UPLOAD_MB=25
REQUIRE_STRICT_CORS=true
# Session JWT lifetime in seconds (default 7 days = 604800).
SESSION_TTL_SECONDS=604800
# Only trust CF-Connecting-IP / X-Forwarded-For forwarded-IP headers when
# actually behind a trusted proxy (Cloudflare). Set false if the app is
# directly internet-facing, else attackers can spoof them to evade rate limits.
TRUST_PROXY_HEADERS=true

# ----------------------------------------------------------------------------
# Cloudflare Access (production only - leave empty for self-hosted dev)
# ----------------------------------------------------------------------------
CLOUDFLARE_ACCESS_AUD=
CLOUDFLARE_ACCESS_TEAM_DOMAIN=
ADMIN_EMAILS=

# ============================================================================
# AI providers (OPTIONAL - drop in EITHER key, not both)
# ============================================================================
# 508 Agent uses AI for the parts that need judgement: alt-text on images,
# link-text rewrites, document language inference. Without a key, the app
# falls back to local heuristics (works fine, but lower quality).
#
# Pick ONE provider:
#
# Option A: Anthropic Claude (recommended - vision-capable, high quality)
#   Get a key at https://console.anthropic.com/settings/keys
#   Paste it on the line below.
ANTHROPIC_API_KEY=

# Optional - override the default model. Leave blank to use claude-3-5-sonnet.
ANTHROPIC_MODEL=

# Option B: OpenAI (alternative)
#   Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Force a specific provider if you have BOTH keys set. Leave blank to let the
# backend auto-pick (Anthropic wins if both are set).
# Valid values: claude | openai | heuristic
SEMANTIC_PROVIDER=

# Cap AI spend per remediation job in USD (0 disables the cap). When the cap is
# hit mid-job the client falls back to heuristics for the rest of the document
# so a runaway image-heavy file cannot blow your margin.
MAX_AI_COST_PER_JOB_USD=0.50

# ============================================================================
# Where to put the key:
# ============================================================================
# 1. Copy this file:    cp .env.example .env
# 2. Open .env and paste your Anthropic key after ANTHROPIC_API_KEY=
# 3. Restart the backend:   python dev_run.py
# 4. Confirm in the UI:     Settings > AI provider should show "claude"
# ============================================================================

# ============================================================================
# Email (email verification links) - OPTIONAL
# ============================================================================
# Without SMTP_HOST, verification emails are logged to the server console so a
# developer can copy the link. Set these in production to actually send mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true
# Absolute base URL used to build links in emails, e.g. https://app.example.com
PUBLIC_BASE_URL=

# ============================================================================
# Stripe billing (OPTIONAL - leave blank to keep dev-mock /credits/purchase)
# ============================================================================
# When STRIPE_SECRET_KEY is set, the backend exposes /billing/* endpoints
# (Checkout + webhook) and /credits/purchase returns 409 use_stripe_checkout
# so the UI is forced through the real flow.
#
# Get your secret key:   https://dashboard.stripe.com/apikeys  (sk_test_... in test mode)
STRIPE_SECRET_KEY=
# Get your webhook signing secret after creating a webhook endpoint at
# https://dashboard.stripe.com/webhooks  (whsec_...). Required if you want
# Stripe -> /billing/webhook to actually credit users.
STRIPE_WEBHOOK_SECRET=
# Create Products + Prices in the dashboard, then paste the price_... ids here.
# https://dashboard.stripe.com/products
#
# One-time credit packs (one-time Prices). Tier -> credits: starter=50, pro=250, studio=1300.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_STUDIO=
# Subscriptions (RECURRING Prices). Monthly credits: team=1000, business=6000;
# annual plans bill yearly and grant 12x up front. Conformance certificates are
# free for active subscribers (others spend a few credits each).
# Suggested: Team $99/mo or $990/yr; Business $499/mo or $4990/yr.
STRIPE_PRICE_TEAM=
STRIPE_PRICE_TEAM_ANNUAL=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_BUSINESS_ANNUAL=
#
# Webhook events to enable on the Stripe endpoint:
#   checkout.session.completed, invoice.payment_succeeded,
#   customer.subscription.deleted, customer.subscription.updated
