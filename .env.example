APP_ENV=development
APP_VERSION=0.1.0

# sqlite dev default
DATABASE_URL=sqlite:///./.runtime/508_agent.db

# production target (future repo backend support)
# DATABASE_URL=postgresql+psycopg://agent:password@localhost:5432/agentdb

STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=backend/.runtime/storage
MATERIALIZED_ROOT=backend/.runtime/materialized

# for STORAGE_PROVIDER=s3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=
S3_PREFIX=508-agent
S3_ENDPOINT_URL=
S3_FORCE_PATH_STYLE=true
PRESIGN_EXPIRES_SECONDS=3600
ENABLE_DEV_STORAGE_ENDPOINT=false

# optional AI manual-review assist (PDF missing alt text only)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

CORS_ALLOW_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:3000,http://127.0.0.1:3000
MAX_UPLOAD_MB=25
REQUIRE_STRICT_CORS=true
