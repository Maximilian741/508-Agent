# 508-Agent — production / VPS deployment env vars.
# Copy this file to ``.env`` next to docker-compose.yml and fill in the
# values.  ``docker compose up -d`` will pick it up automatically.

# ---------------------------------------------------------------------------
# Required — application
# ---------------------------------------------------------------------------

# Strong random secret used for HMAC-signed download URLs.  Must be set in
# production; the backend refuses to start without it.  Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET=

APP_ENV=production
APP_VERSION=0.1.0

# How long pipeline artifacts (remediated files, share JSON) live on disk
# before the cleanup task removes them.  Default 24h.
PIPELINE_ARTIFACT_TTL_SECONDS=86400

# Comma-separated origins the API will accept cross-origin requests from.
# Set this to your public hostname(s) — never use ``*`` in production.
CORS_ALLOW_ORIGINS=https://app.example.com

# Maximum upload size in megabytes.  Hard 413 above this.
MAX_UPLOAD_MB=25

# Session JWT lifetime (seconds, default 7 days). Trust forwarded-IP headers
# only behind Cloudflare / a trusted proxy.
SESSION_TTL_SECONDS=604800
TRUST_PROXY_HEADERS=true

# Comma-separated admin emails (grant the Admin tab + audit-log access).
ADMIN_EMAILS=

# ---------------------------------------------------------------------------
# Required — Postgres (docker-compose `db` service)
# ---------------------------------------------------------------------------
# docker-compose REQUIRES a strong POSTGRES_PASSWORD (no default). Generate:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_USER=agent
POSTGRES_PASSWORD=
POSTGRES_DB=agentdb

# ---------------------------------------------------------------------------
# Required — frontend build
# ---------------------------------------------------------------------------
# The public URL the web app calls. Inlined into the static bundle at build
# time; docker-compose REQUIRES it (no default).
EXPO_PUBLIC_API_URL=https://api.example.com

# ---------------------------------------------------------------------------
# Required — object storage (Cloudflare R2 example)
# ---------------------------------------------------------------------------

STORAGE_PROVIDER=s3
S3_BUCKET=508-agent
# Cloudflare R2 endpoint:
#   https://<accountid>.r2.cloudflarestorage.com
S3_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
AWS_REGION=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_PREFIX=508-agent

# ---------------------------------------------------------------------------
# Required — Cloudflare Tunnel + Access
# ---------------------------------------------------------------------------

# Tunnel token from "zero-trust → access → tunnels → <tunnel> → install
# connector".  Treat this as a credential.
CF_TUNNEL_TOKEN=

# Your Zero Trust team domain, e.g. ``yourteam.cloudflareaccess.com``.
CLOUDFLARE_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com

# Application AUD tag from Access → Applications.
# IMPORTANT: this product is a PUBLIC self-serve SaaS — end users sign in with
# the app's own accounts, NOT Cloudflare Access. LEAVE THIS EMPTY for a public
# launch. Setting it puts a Cloudflare Access login in front of the whole site,
# which would 401 your customers, the Stripe webhook, and public certificate
# links. Only set it if you are deploying a private/internal instance.
CLOUDFLARE_ACCESS_AUD=

# ---------------------------------------------------------------------------
# Required for a paid launch — Stripe billing
# ---------------------------------------------------------------------------
# Without STRIPE_SECRET_KEY the /billing/* endpoints return 503 and the site
# comes up "healthy" but cannot take money. Set both keys + the price ids.
#   Secret key:     https://dashboard.stripe.com/apikeys      (sk_live_… / sk_test_…)
#   Webhook secret: https://dashboard.stripe.com/webhooks     (whsec_…), point the
#     endpoint at https://<api-host>/billing/webhook for events:
#     checkout.session.completed, invoice.payment_succeeded,
#     customer.subscription.updated, customer.subscription.deleted
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Create these EXACT Prices in the Stripe dashboard — the dollar amounts below
# are what the billing page advertises, so the Price you create must match or
# customers will see one number and be charged another.
#
# One-time credit packs (one-time Prices):
#   starter = $5.00  -> 50 credits
#   pro     = $15.00 -> 250 credits
#   studio  = $50.00 -> 1,300 credits
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_STUDIO=
# Subscriptions (RECURRING Prices):
#   team            = $99.00/month   -> 1,000 credits granted monthly
#   team_annual     = $990.00/year   -> 12,000 credits granted up front
#   business        = $499.00/month  -> 6,000 credits granted monthly
#   business_annual = $4,990.00/year -> 72,000 credits granted up front
STRIPE_PRICE_TEAM=
STRIPE_PRICE_TEAM_ANNUAL=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_BUSINESS_ANNUAL=

# ---------------------------------------------------------------------------
# Required for a paid launch — AI provider (alt-text quality)
# ---------------------------------------------------------------------------
# Without an API key the engine falls back to a TEMPLATE heuristic for alt
# text ("Image shown in page N") — acceptable for dev, NOT for files customers
# pay to remediate. Set ANTHROPIC_API_KEY before charging money.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Cap AI spend per remediation job in USD (0 disables).
MAX_AI_COST_PER_JOB_USD=0.50

# ---------------------------------------------------------------------------
# Optional — email (verification links; logged to console without SMTP)
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true
PUBLIC_BASE_URL=https://app.example.com

# ---------------------------------------------------------------------------
# Optional — database
# ---------------------------------------------------------------------------

# Default is sqlite at /app/.runtime/508_agent.db.  Switch to managed
# Postgres if you outgrow that:
#   DATABASE_URL=postgresql+psycopg://user:pass@host:5432/db
DATABASE_URL=
