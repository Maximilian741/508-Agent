# Public backend URL injected at build time by Expo.
# Anything prefixed EXPO_PUBLIC_ is bundled into the static web export
# and will be visible to clients - do NOT put secrets here.
#
# In dev, you can leave this unset; the app will fall back to
# http://localhost:8000 (or read /backend_url.txt at runtime).
#
# In prod, set this to your deployed backend's public origin.
EXPO_PUBLIC_API_URL=https://api.example.com
